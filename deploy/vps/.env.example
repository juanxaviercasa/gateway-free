# Plantilla de entorno para despliegue en VPS detrás de Cloudflare Tunnel o reverse proxy HTTPS.
# NUNCA subas tu .env real al repositorio.
# Genera ENCRYPTION_KEY con: openssl rand -hex 32

ENCRYPTION_KEY=reemplaza-con-clave-hex-de-64-caracteres
PORT=3001
HOST_BIND=127.0.0.1
TRUST_PROXY=1
ALLOWED_HOSTS=llm.forjavia.site
DASHBOARD_ORIGINS=https://llm.forjavia.site
