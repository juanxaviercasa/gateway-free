# Plantilla para importación masiva en FreeLLMAPI (Dashboard -> Claves -> Importar).
# Copia este archivo fuera del repo (por ejemplo: mis-claves.env), rellena SOLO las líneas
# de los proveedores que hayas creado, y súbelo desde el panel o vía API (/api/keys/import).
# NUNCA subas un archivo con claves reales a Git.

# --- Proveedores principales gratuitos (modelos open-weight y gratuitos) ---
GOOGLE_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
HUGGINGFACE_API_KEY=
# Cloudflare Workers AI usa formato account_id:api_token
CLOUDFLARE_API_KEY=
ZHIPU_API_KEY=
OLLAMA_CLOUD_API_KEY=

# --- Otros agregadores y gateways con capa gratuita ---
